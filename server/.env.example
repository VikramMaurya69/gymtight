# GymTight Fitness Bridge Server - Executable Configuration

# Firebase Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# ETimeTrack Database Configuration (Client's Existing Setup)
# Update this path to point to client's ETimeTrack database
ETIMETRACK_DB_PATH=C:\\Program Files\\ZKTeco\\ETimeTrack\\att2024.mdb
# Alternative common paths:
# ETIMETRACK_DB_PATH=C:\\ETimeTrack\\att2024.mdb
# ETIMETRACK_DB_PATH=C:\\Program Files (x86)\\ZKTeco\\ETimeTrack\\att2024.mdb

# API Server Configuration
API_PORT=3001

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
CORS_ORIGIN=https://your-netlify-app.netlify.app

# Bridge Configuration
SYNC_INTERVAL_MS=5000
DEBUG_MODE=false

# Windows Service Configuration
SERVICE_NAME=GymTight Fitness Bridge Server
SERVICE_DESCRIPTION=Bridge server for GymTight Fitness Admin Panel and ETimeTrack integration