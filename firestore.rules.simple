rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // SIMPLIFIED RULES FOR INITIAL SETUP
    // These rules are more permissive to allow your app to work
    // You can tighten them later after testing
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Users collection - Allow authenticated users to manage their data
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Members collection - Allow all authenticated users
    match /members/{memberId} {
      allow read, write: if isAuthenticated();
    }
    
    // Trainers collection - Allow all authenticated users
    match /trainers/{trainerId} {
      allow read, write: if isAuthenticated();
    }
    
    // Packages collection - Allow all authenticated users
    match /packages/{packageId} {
      allow read, write: if isAuthenticated();
    }
    
    // Subscriptions collection - Allow all authenticated users
    match /subscriptions/{subscriptionId} {
      allow read, write: if isAuthenticated();
    }
    
    // Attendance collection - Allow all authenticated users
    match /attendance/{attendanceId} {
      allow read, write: if isAuthenticated();
    }
    
    // Fingerprint registrations - Allow all authenticated users
    match /fingerprint_registrations/{registrationId} {
      allow read, write: if isAuthenticated();
    }
    
    // Branches collection - Allow all authenticated users
    match /branches/{branchId} {
      allow read, write: if isAuthenticated();
    }
    
    // Audit logs - Allow creation by authenticated users
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
    
    // Settings - Allow all authenticated users
    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }
    
    // Security settings - Allow all authenticated users
    match /security_settings/{settingId} {
      allow read, write: if isAuthenticated();
    }
    
    // Activity logs - Allow all authenticated users
    match /activity_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
